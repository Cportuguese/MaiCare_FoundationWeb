---
/**
 * Events & News page (Phase 7).
 *
 * Design direction (different from Home, About, Programs and Get Involved)
 *  1. Header: heading, intro and three jump links, with a faint heart-and-leaf line art.
 *     The pink underline is used once (the h1).
 *  2. Upcoming events: one white panel of ruled rows. Each row is a date badge,
 *     the event, and a "details" cue. Looks like a calendar list, not cards.
 *  3. Past events: image-led cards on white. No cover photo means a tinted icon
 *     panel (never a stock photo).
 *  4. News: text-led. Heading on the left, a ruled list of dated headlines on
 *     the right, no pictures.
 *  5. Closing panel with the one pink button.
 *
 * Everything comes from the Markdown files in src/content/events and
 * src/content/news. Nothing is typed in here. Empty sections show a calm,
 * honest note. See HOW-TO-ADD-POSTS.md.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Button from '../components/Button.astro';
import HeartLeaf from '../components/HeartLeaf.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { contactHref } from '../data/nav';
import { contact } from '../data/site';
import { formatDay, getEventLists, getNewsList } from '../data/posts';

const { upcoming, past } = await getEventLists();
const news = await getNewsList();
const hasSamples = [...upcoming, ...past, ...news].some((p) => p.sample);
---

<PageLayout
  title="Events & News"
  description="Upcoming and past events and news from maiCare Foundation in San Carlos City, Pangasinan."
>
  <!-- 1. Header -->
  <section class="relative overflow-hidden">
    <HeartLeaf class="pointer-events-none absolute -right-12 top-2 size-52 rotate-12 text-pink-500 opacity-[0.12] md:right-8 md:size-72" />
    <div class="container-page relative pb-10 pt-10 md:pb-14 md:pt-16">
      <SectionHeading
        level="h1"
        label="Events and news"
        title="What's happening"
        underline="happening"
        intro="Where we will be, what we have done, and news from the foundation. Come to an event, or send us a message if you would like to help at one."
        class="fade-in"
      />
      <nav aria-label="Jump to a section" class="mt-8">
        <ul class="flex flex-wrap gap-3">
          {
            [
              { id: 'upcoming', label: 'Upcoming events', icon: 'calendar' },
              { id: 'past', label: 'Past events', icon: 'clock' },
              { id: 'news', label: 'News', icon: 'newspaper' },
            ].map((link) => (
              <li>
                <a
                  href={`#${link.id}`}
                  class="inline-flex min-h-11 items-center gap-2 rounded-full bg-white px-5 font-semibold text-green-800 no-underline shadow-soft transition-colors hover:text-pink-700"
                >
                  <Icon name={link.icon as 'calendar' | 'clock' | 'newspaper'} size={18} class="text-pink-600" />
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      {
        hasSamples && (
          <p class="mt-8 flex max-w-2xl gap-3 rounded-card bg-white p-4 text-small text-ink-600 ring-1 ring-pink-200">
            <Icon name="info" size={20} class="mt-0.5 shrink-0 text-pink-600" />
            <span>
              Posts marked <strong class="text-green-800">Sample</strong> are examples that show how this page will look. They are not real events or announcements.
            </span>
          </p>
        )
      }
    </div>
  </section>

  <!-- 2. Upcoming events: ruled rows in one panel -->
  <section id="upcoming" aria-labelledby="upcoming-heading">
    <div class="container-page pb-14 md:pb-20">
      <h2 id="upcoming-heading" class="text-h2">Upcoming events</h2>
      {
        upcoming.length > 0 ? (
          <ul class="mt-8 divide-y divide-pink-100 overflow-hidden rounded-panel bg-white shadow-soft">
            {upcoming.map((event) => {
              const meta = [event.time, event.place].filter(Boolean).join(' · ');
              return (
                <li class="group relative flex items-center gap-4 p-5 transition-colors hover:bg-pink-50 has-[a:focus-visible]:bg-pink-50 sm:gap-6 sm:p-7">
                  <time
                    datetime={event.date}
                    class="grid size-16 shrink-0 place-items-center rounded-2xl bg-pink-100 text-center leading-none text-green-800 sm:size-20"
                  >
                    <span>
                      <span class="block text-small font-semibold text-pink-600">
                        {formatDay(event.date, { month: 'short' })}
                      </span>
                      <span class="mt-1 block text-2xl font-extrabold sm:text-3xl">
                        {formatDay(event.date, { day: 'numeric' })}
                      </span>
                    </span>
                  </time>
                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-2 text-small font-semibold">
                      <span class="text-ink-500">{event.dateLabel}</span>
                      {event.sample && (
                        <span class="rounded-full bg-green-100 px-3 py-0.5 text-green-800">Sample</span>
                      )}
                    </div>
                    <h3 class="mt-1 text-h3">
                      <a
                        href={event.href}
                        class="text-green-800 no-underline after:absolute after:inset-0 after:content-[''] group-hover:text-pink-700"
                      >
                        {event.title}
                      </a>
                    </h3>
                    {meta && <p class="mt-1 text-small text-ink-500">{meta}</p>}
                    <p class="mt-2 text-body text-ink-600">{event.summary}</p>
                  </div>
                  <Icon name="arrow-right" size={22} class="hidden shrink-0 text-pink-600 sm:block" />
                </li>
              );
            })}
          </ul>
        ) : (
          <div class="mt-8 flex flex-col gap-5 rounded-panel bg-white p-6 shadow-soft sm:flex-row sm:items-center sm:gap-8 md:p-9">
            <span class="grid size-14 shrink-0 place-items-center rounded-full bg-pink-100 text-pink-600">
              <Icon name="calendar" size={26} />
            </span>
            <div class="max-w-2xl">
              <h3 class="text-h3 text-green-800">No events are scheduled right now</h3>
              <p class="mt-2 text-body text-ink-600">
                We are just getting started. When we plan an event, it will be listed here
                {contact.facebookUrl ? ' and on our Facebook page.' : '.'} Send us a message if you would like to hear about it first.
              </p>
            </div>
            <Button href={contactHref('other')} variant="secondary" class="sm:ml-auto">Message us</Button>
          </div>
        )
      }
    </div>
  </section>

  <!-- 3. Past events: image-led cards -->
  <section id="past" class="bg-white" aria-label="Past events">
    <div class="container-page section">
      <SectionHeading
        label="Looking back"
        title="Past events"
        intro="What we have done, with photos once we have them."
      />
      {
        past.length > 0 ? (
          <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {past.map((event) => (
              <li class="flex">
                <PostCard post={event} class="w-full" />
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-8 max-w-2xl rounded-card bg-pink-50 p-6 text-body text-ink-600 ring-1 ring-pink-200">
            Our past events will be listed here, with photos, after we have held them.
          </p>
        )
      }
    </div>
  </section>

  <!-- 4. News: text-led -->
  <section id="news" aria-label="News">
    <div class="container-page section grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <SectionHeading
          label="From the foundation"
          title="News"
          intro="Short updates: thank-yous, calls for help, and reports on finished drives."
        />
      </div>
      {
        news.length > 0 ? (
          <ul class="divide-y divide-pink-200 border-y border-pink-200">
            {news.map((post) => (
              <li class="group relative py-7 has-[a:focus-visible]:bg-pink-100/50">
                <div class="flex flex-wrap items-center gap-2">
                  <time datetime={post.date} class="text-label text-pink-600">
                    {post.dateLabel}
                  </time>
                  {post.sample && (
                    <span class="rounded-full bg-green-100 px-3 py-0.5 text-small font-semibold text-green-800">
                      Sample
                    </span>
                  )}
                </div>
                <h3 class="mt-2 text-h3">
                  <a
                    href={post.href}
                    class="text-green-800 no-underline after:absolute after:inset-0 after:content-[''] group-hover:text-pink-700"
                  >
                    {post.title}
                  </a>
                </h3>
                <p class="mt-2 max-w-xl text-body text-ink-600">{post.summary}</p>
              </li>
            ))}
          </ul>
        ) : (
          <p class="self-start rounded-card bg-white p-6 text-body text-ink-600 shadow-soft">
            No news yet. Our first posts will appear here as soon as they are published.
          </p>
        )
      }
    </div>
  </section>

  <!-- 5. Closing panel -->
  <section class="container-page pb-16 pt-2 md:pb-24" aria-labelledby="events-cta-heading">
    <div class="relative overflow-hidden rounded-panel bg-pink-100 px-6 py-12 md:px-14 md:py-16">
      <HeartLeaf class="pointer-events-none absolute -right-4 -top-6 size-40 rotate-12 text-pink-500 opacity-25 md:right-4 md:top-4 md:size-56" />
      <div class="relative max-w-xl">
        <h2 id="events-cta-heading" class="text-h2 text-green-800">Help at our next event</h2>
        <p class="mt-4 text-lead text-ink-600">
          Volunteers help with packing, bringing goods to families and setting up. Tell us when you are free, and we will reply with the next step.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <Button href={contactHref('volunteer')} size="lg">Volunteer with us</Button>
          <Button href="/get-involved/" variant="secondary" size="lg">See all the ways to help</Button>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
