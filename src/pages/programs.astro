---
/**
 * Programs page (Phase 5).
 *
 * Design direction (different from Home's grid and from About's text-led layout)
 *  1. Header: heading, intro and three jump links (one per focus group), with a
 *     faint butterfly at the corner. The pink underline is used once (the h1).
 *  2. Focus groups: three full-width rows that alternate sides (visual / words /
 *     visual...). Each row says who we want to help, what help is needed, and
 *     links to How to Donate.
 *     The "visual" is a designed icon panel, NOT a stock photo: there is no
 *     honest photo of the people we will help yet. Drop a real photo into
 *     src/assets/images/programs/ named students.jpg, storm-relief.jpg or
 *     orphans-elderly.jpg (jpg, jpeg, png or webp) and that row shows it
 *     automatically. Real photos of people, especially children, need written
 *     guardian consent first.
 *  3. Program areas: a ruled list (icon / name / description), like a table.
 *  4. Closing panel with the one pink button.
 *
 * Wording comes from the foundation's brief and its earlier draft. It says "we
 * want to", not "we did": there is no track record yet. No numbers or names.
 */
import { Image } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import Button from '../components/Button.astro';
import Butterfly from '../components/Butterfly.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { donateLink } from '../data/nav';

// Optional real photos, picked up by file name (see the note above).
const photoFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/programs/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
const findPhoto = (slug: string) =>
  Object.entries(photoFiles).find(([path]) => path.split('/').pop()?.startsWith(`${slug}.`))?.[1].default;

const focusAreas: {
  id: string;
  icon: IconName;
  chip: string;
  title: string;
  who: string;
  needs: string[];
  cta: string;
}[] = [
  {
    id: 'students',
    icon: 'graduation-cap',
    chip: 'Students',
    title: 'Students who struggle to stay in school',
    who: 'Children and young people whose families find it hard to pay for school. When money is tight, school is often the first thing to go. We want to help them keep learning.',
    needs: [
      'Scholarships for deserving students',
      'School supplies, such as notebooks, pens and bags',
      'Literacy and learning programs',
    ],
    cta: 'How to help students',
  },
  {
    id: 'storm-relief',
    icon: 'cloud-lightning',
    chip: 'Storm relief',
    title: 'Families hit by typhoons',
    who: 'Families in Pangasinan who lose their home, food or income to a typhoon or a flood. We want to bring relief fast, then help families get back on their feet.',
    needs: [
      'Food and clothes for relief packs',
      'Money for emergency needs and rebuilding',
      'Volunteers to pack and hand out relief goods',
    ],
    cta: 'How to help with relief',
  },
  {
    id: 'orphans-elderly',
    icon: 'heart-handshake',
    chip: 'Orphans and the elderly',
    title: 'Orphans and the elderly',
    who: 'Children without parents and older neighbors, who can go unnoticed. We want to make sure someone shows up with food, care and company.',
    needs: [
      'Food and clothes for children and senior citizens',
      'Volunteers who can visit and spend time',
      'Support for everyday care',
    ],
    cta: 'How to help',
  },
];

const programAreas: { icon: IconName; name: string; text: string }[] = [
  { icon: 'hand-heart', name: 'Charitable', text: 'Relief goods and aid for the poor and for families hit by calamities.' },
  { icon: 'graduation-cap', name: 'Educational', text: 'Scholarships, school supplies and literacy programs for deserving students.' },
  { icon: 'sprout', name: 'Livelihood', text: 'Skills training and small-business support to help families earn on their own.' },
  { icon: 'heart-pulse', name: 'Health', text: 'Medical and dental missions, medicines and nutrition programs for indigent families.' },
  { icon: 'users', name: 'Social welfare', text: 'Care for children, youth, women, senior citizens and persons with disabilities.' },
];
---

<PageLayout
  title="Programs"
  description="The three groups maiCare Foundation wants to help first in San Carlos City, Pangasinan: students, families hit by typhoons, and orphans and the elderly. See who each program helps and what help is needed."
>
  <!-- 1. Header -->
  <section class="relative overflow-hidden">
    <Butterfly class="pointer-events-none absolute -right-12 top-2 size-52 rotate-12 text-pink-500 opacity-[0.12] md:right-8 md:size-72" />
    <div class="container-page relative pb-10 pt-10 md:pb-14 md:pt-16">
      <SectionHeading
        level="h1"
        label="Our programs"
        title="What we do"
        underline="we do"
        intro="We start with three groups of people in San Carlos City and across Pangasinan. Here is who each one is, and what kind of help is needed."
        class="fade-in"
      />
      <nav aria-label="Jump to a focus group" class="mt-8">
        <ul class="flex flex-wrap gap-3">
          {
            focusAreas.map((area) => (
              <li>
                <a
                  href={`#${area.id}`}
                  class="inline-flex min-h-11 items-center gap-2 rounded-full bg-white px-5 font-semibold text-olive-800 no-underline shadow-soft transition-colors hover:text-pink-700"
                >
                  <Icon name={area.icon} size={18} class="text-pink-600" />
                  {area.chip}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>

  <!-- 2. Focus groups: alternating full-width rows -->
  {
    focusAreas.map((area, i) => {
      const photo = findPhoto(area.id);
      const flip = i % 2 === 1;
      return (
        <section id={area.id} class:list={['scroll-mt-24', i % 2 === 0 ? 'bg-white' : '']} aria-labelledby={`${area.id}-heading`}>
          <div class="container-page grid items-center gap-8 py-12 md:py-20 lg:grid-cols-2 lg:gap-16">
            <div class:list={['relative', flip && 'lg:order-2']}>
              {photo ? (
                <Image
                  src={photo}
                  alt=""
                  widths={[480, 720, 960]}
                  sizes="(min-width: 1024px) 560px, calc(100vw - 2rem)"
                  format="webp"
                  quality={78}
                  class="aspect-[4/3] w-full rounded-panel object-cover shadow-soft"
                />
              ) : (
                <div
                  class:list={[
                    'relative grid aspect-[16/10] place-items-center overflow-hidden rounded-panel lg:aspect-[4/3]',
                    i % 2 === 0 ? 'bg-pink-100' : 'bg-white shadow-soft',
                  ]}
                >
                  <Butterfly
                    class:list={[
                      'pointer-events-none absolute size-40 text-pink-500 opacity-20 md:size-56',
                      flip ? '-left-6 -top-6 -rotate-12' : '-bottom-6 -right-6 rotate-12',
                    ]}
                  />
                  <span class:list={['relative grid size-24 place-items-center rounded-full text-pink-600 md:size-28', i % 2 === 0 ? 'bg-white' : 'bg-pink-100']}>
                    <Icon name={area.icon} size={44} />
                  </span>
                </div>
              )}
            </div>

            <div class:list={[flip && 'lg:order-1']}>
              <p class="font-accent text-label font-medium italic text-pink-600">Focus {i + 1} of 3</p>
              <h2 id={`${area.id}-heading`} class="mt-3 text-h2 text-olive-800">{area.title}</h2>
              <p class="mt-4 max-w-xl text-lead text-ink-600">{area.who}</p>

              <h3 class="mt-7 text-h3 text-olive-800">Help we need</h3>
              <ul class="mt-3 space-y-2">
                {area.needs.map((need) => (
                  <li class="flex gap-3 text-body text-ink-600">
                    <Icon name="check" size={20} class="mt-1 shrink-0 text-pink-600" />
                    <span>{need}</span>
                  </li>
                ))}
              </ul>

              <div class="mt-8">
                <Button href={donateLink.href} variant="secondary" icon="arrow-right">{area.cta}</Button>
              </div>
            </div>
          </div>
        </section>
      );
    })
  }

  <!-- 3. Program areas: ruled list -->
  <section aria-labelledby="areas-heading">
    <div class="container-page section">
      <SectionHeading
        label="Five program areas"
        title="How our work is organized"
        intro="Our programs fall under these five areas. Each program is planned with the community it serves and reported openly to our donors. We are just getting started, so not every area has begun yet."
      />
      <ul class="mt-10 divide-y divide-pink-200 border-y border-pink-200">
        {
          programAreas.map((area) => (
            <li class="grid grid-cols-[3rem_1fr] items-start gap-x-5 gap-y-1 py-6 md:grid-cols-[3rem_12rem_1fr] md:items-center md:gap-x-8 md:py-7">
              <span class="row-span-2 grid size-12 place-items-center rounded-full bg-white text-pink-600 shadow-soft md:row-span-1">
                <Icon name={area.icon} size={22} />
              </span>
              <h3 class="text-h3 text-olive-800">{area.name}</h3>
              <p class="col-start-2 text-body text-ink-600 md:col-start-3">{area.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 4. Closing panel -->
  <section class="container-page pb-16 md:pb-24" aria-labelledby="programs-cta-heading">
    <div class="rounded-panel bg-white p-7 shadow-soft md:flex md:items-center md:justify-between md:gap-10 md:p-12">
      <div class="max-w-xl">
        <h2 id="programs-cta-heading" class="text-h2 text-olive-800">Not sure where your help fits?</h2>
        <p class="mt-3 text-lead text-ink-600">
          Tell us what you can give, whether it is money, clothes, food or your time, and we will point you to the right program.
        </p>
      </div>
      <div class="mt-7 flex flex-wrap gap-3 md:mt-0 md:shrink-0">
        <Button href="/contact/" size="lg">Contact us</Button>
        <Button href="/get-involved/" variant="secondary" size="lg">See ways to help</Button>
      </div>
    </div>
  </section>
</PageLayout>
