---
/**
 * Footer
 * ------
 * Deep olive. Everything about contact details comes from src/data/site.ts.
 * A value that is `null` there is simply not shown (no blanks, no invented values).
 */
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import Button from './Button.astro';
import { contact, identity } from '../data/site';
import { navLinks, privacyLink } from '../data/nav';

const { address, phone, emailInfo, emailDonate, facebookUrl, secRegistrationNumber, officeHours } = contact;

const addressLine = [address.street, address.city, address.province, address.country].filter(Boolean).join(', ');
const telHref = phone ? `tel:${phone.replace(/[^\d+]/g, '')}` : null;
const year = new Date().getFullYear();

const link =
  'inline-flex min-h-11 items-center text-cream-200 no-underline hover:text-white hover:underline decoration-pink-300 decoration-2';
const heading = 'font-accent text-label italic font-medium text-pink-300';
---

<footer data-surface="dark" class="relative overflow-hidden bg-olive-900 text-cream-200">
  <div class="container-page relative section !pb-10">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1.3fr]">
      <!-- Who we are -->
      <div class="max-w-sm">
        <a href="/" class="inline-flex min-h-12 items-center rounded-xl no-underline" aria-label={`${identity.shortName} Foundation, home`}>
          <Logo tone="dark" />
        </a>
        <p class="mt-5 text-small text-pink-50/90">{identity.description}</p>
        {secRegistrationNumber && (
          <p class="mt-4 text-small text-pink-50/90">
            SEC registration no. <span class="font-semibold text-white">{secRegistrationNumber}</span>
          </p>
        )}
        <div class="mt-6">
          <Button href="/contact/" variant="on-dark">Contact us</Button>
        </div>
      </div>

      <!-- Pages -->
      <nav aria-label="Footer">
        <h2 class={heading}>Pages</h2>
        <ul class="mt-3 grid grid-cols-2 gap-x-6 md:grid-cols-1">
          {
            navLinks.map((item) => (
              <li>
                <a href={item.href} class={link}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Reach us -->
      <div>
        <h2 class={heading}>Reach us</h2>
        <ul class="mt-3 flex flex-col gap-3 text-small">
          <li class="flex gap-3">
            <Icon name="map-pin" size={20} class="mt-0.5 shrink-0 text-pink-300" />
            <span>{addressLine}</span>
          </li>
          {
            phone && telHref && (
              <li class="flex gap-3">
                <Icon name="phone" size={20} class="mt-0.5 shrink-0 text-pink-300" />
                <a href={telHref} class="text-cream-200 hover:text-white">
                  {phone}
                </a>
              </li>
            )
          }
          {
            emailInfo && (
              <li class="flex gap-3">
                <Icon name="mail" size={20} class="mt-0.5 shrink-0 text-pink-300" />
                <a href={`mailto:${emailInfo}`} class="break-all text-cream-200 hover:text-white">
                  {emailInfo}
                </a>
              </li>
            )
          }
          {
            emailDonate && (
              <li class="flex gap-3">
                <Icon name="hand-heart" size={20} class="mt-0.5 shrink-0 text-pink-300" />
                <span>
                  Donations:{' '}
                  <a href={`mailto:${emailDonate}`} class="break-all text-cream-200 hover:text-white">
                    {emailDonate}
                  </a>
                </span>
              </li>
            )
          }
          {
            officeHours && (
              <li class="flex gap-3">
                <Icon name="clock" size={20} class="mt-0.5 shrink-0 text-pink-300" />
                <span>{officeHours}</span>
              </li>
            )
          }
          {
            facebookUrl && (
              <li>
                <a
                  href={facebookUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex min-h-11 items-center gap-2 font-semibold text-white underline decoration-pink-300 decoration-2 underline-offset-4"
                >
                  Follow us on Facebook
                  <Icon name="arrow-right" size={16} />
                </a>
              </li>
            )
          }
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-2 border-t border-olive-700 pt-6 text-small text-olive-200 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {identity.name}</p>
      <a href={privacyLink.href} class="inline-flex min-h-11 items-center text-cream-200 hover:text-white">{privacyLink.label}</a>
    </div>
  </div>
</footer>
