---
/**
 * PageShell: TEMPORARY. Used only while the pages are empty shells (Phase 3).
 * It shows the page title and dashed placeholder blocks that list what each
 * section will hold. Each page's own phase (4 to 7) replaces this with the real
 * design, and this component can then be deleted.
 *
 * `blocks[].id` gives a block an anchor, so links like /get-involved/#how-to-donate
 * already land in the right place.
 */
import SectionHeading from './SectionHeading.astro';
import Butterfly from './Butterfly.astro';

interface Block {
  title: string;
  note: string;
  id?: string;
}

interface Props {
  label: string;
  title: string;
  intro: string;
  /** The phase that builds the real page, e.g. "Phase 4". */
  builtIn: string;
  blocks?: Block[];
}

const { label, title, intro, builtIn, blocks = [] } = Astro.props;
---

<section class="relative overflow-hidden">
  <Butterfly class="pointer-events-none absolute -right-12 top-2 size-52 rotate-12 text-pink-500 opacity-[0.12] md:right-8 md:size-72" />
  <div class="container-page section relative !pb-10 md:!pb-14">
    <SectionHeading level="h1" label={label} title={title} intro={intro} class="fade-in" />
    <p class="mt-6 inline-flex items-center rounded-full bg-pink-100 px-4 py-2 text-small font-semibold text-olive-800">
      Placeholder page. The real content is built in {builtIn}.
    </p>
  </div>
</section>

{
  blocks.length > 0 && (
    <section class="container-page pb-16 md:pb-24">
      <ul class="grid gap-4 md:grid-cols-2">
        {blocks.map((block) => (
          <li
            id={block.id}
            class="scroll-mt-24 rounded-card border-2 border-dashed border-pink-300 bg-white/60 p-6"
          >
            <h2 class="text-h3">{block.title}</h2>
            <p class="mt-2 text-small text-ink-600">{block.note}</p>
          </li>
        ))}
      </ul>
    </section>
  )
}
