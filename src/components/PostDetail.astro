---
/**
 * PostDetail: the full page for one event or one news post.
 * Used by src/pages/events/[slug].astro and src/pages/news/[slug].astro.
 *
 * Layout: back link, status labels, big title, a details list (date, time, place),
 * optional cover photo, the Markdown body, optional photo gallery (events), and a
 * closing panel with the one pink button. Sample posts get a plain notice and are
 * hidden from search engines.
 */
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import Button from './Button.astro';
import Butterfly from './Butterfly.astro';
import Icon from './Icon.astro';
import Prose from './Prose.astro';
import { contactHref } from '../data/nav';
import { SAMPLE_NOTICE, eventToPost, newsToPost, type EventEntry, type NewsEntry } from '../data/posts';

interface Props {
  entry: EventEntry | NewsEntry;
  kind: 'event' | 'news';
}

const { entry, kind } = Astro.props;
const post = kind === 'event' ? eventToPost(entry as EventEntry) : newsToPost(entry as NewsEntry);
const gallery = kind === 'event' ? (entry as EventEntry).data.gallery : [];
const { Content } = await render(entry);

const label = kind === 'news' ? 'News' : post.upcoming ? 'Upcoming event' : 'Past event';

// Link-preview image: the cover photo cropped to 1200x630, if there is one.
const preview = post.cover
  ? (await getImage({ src: post.cover, width: 1200, height: 630, format: 'jpg', quality: 80 })).src
  : undefined;

const details: { icon: 'calendar' | 'clock' | 'map-pin'; text: string }[] = [];
if (kind === 'event') {
  details.push({ icon: 'calendar', text: post.dateLabel });
  if (post.time) details.push({ icon: 'clock', text: post.time });
  if (post.place) details.push({ icon: 'map-pin', text: post.place });
}
---

<PageLayout title={post.title} description={post.summary} image={preview} noindex={post.sample}>
  <article>
    <header class="relative overflow-hidden">
      <Butterfly class="pointer-events-none absolute -right-12 top-2 size-52 rotate-12 text-pink-500 opacity-[0.12] md:right-8 md:size-72" />
      <div class="container-page relative pb-8 pt-8 md:pb-10 md:pt-12">
        <a
          href={kind === 'event' ? '/events/' : '/events/#news'}
          class="inline-flex min-h-11 items-center gap-2 font-semibold text-pink-600 no-underline hover:text-pink-700"
        >
          <Icon name="arrow-left" size={18} />
          All events and news
        </a>

        <div class="fade-in mt-4 max-w-3xl">
          <div class="flex flex-wrap items-center gap-2 text-small font-semibold">
            <span class="rounded-full bg-pink-100 px-3 py-0.5 text-pink-600">{label}</span>
            {post.sample && <span class="rounded-full bg-olive-100 px-3 py-0.5 text-olive-800">Sample</span>}
          </div>
          <h1 class="mt-4 text-h1 text-olive-800">{post.title}</h1>
          <p class="mt-4 text-lead text-ink-600">{post.summary}</p>

          {
            kind === 'news' && (
              <p class="mt-4 text-small text-ink-500">
                Posted <time datetime={post.date}>{post.dateLabel}</time>
              </p>
            )
          }
          {
            details.length > 0 && (
              <ul class="mt-6 flex flex-col gap-3 text-body text-olive-800">
                {details.map((d) => (
                  <li class="flex items-center gap-3">
                    <span class="grid size-10 shrink-0 place-items-center rounded-full bg-white text-pink-600 shadow-soft">
                      <Icon name={d.icon} size={20} />
                    </span>
                    <span class="font-semibold">{d.text}</span>
                  </li>
                ))}
              </ul>
            )
          }
        </div>
      </div>
    </header>

    <div class="container-page pb-12 md:pb-16">
      {
        post.cover && (
          <Image
            src={post.cover}
            alt={post.coverAlt ?? ''}
            widths={[480, 720, 960, 1280]}
            sizes="(min-width: 1024px) 1008px, calc(100vw - 2rem)"
            format="webp"
            quality={78}
            loading="eager"
            class="mb-10 aspect-[16/9] w-full rounded-panel object-cover shadow-soft"
          />
        )
      }

      {
        post.sample && (
          <p class="mb-8 flex max-w-2xl gap-3 rounded-card bg-white p-4 text-small text-ink-600 ring-1 ring-pink-200">
            <Icon name="info" size={20} class="mt-0.5 shrink-0 text-pink-600" />
            <span>{SAMPLE_NOTICE}</span>
          </p>
        )
      }

      <Prose>
        <Content />
      </Prose>
    </div>

    {
      gallery.length > 0 && (
        <section class="bg-white" aria-labelledby="gallery-heading">
          <div class="container-page section">
            <h2 id="gallery-heading" class="text-h2">Photos</h2>
            <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {gallery.map((photo) => (
                <li>
                  <Image
                    src={photo.image}
                    alt={photo.alt}
                    widths={[400, 640, 900]}
                    sizes="(min-width: 1024px) 330px, (min-width: 640px) 45vw, calc(100vw - 2rem)"
                    format="webp"
                    quality={78}
                    class="aspect-[4/3] w-full rounded-card object-cover shadow-soft"
                  />
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <section class="container-page py-12 md:py-16" aria-labelledby="after-heading">
      <div class="rounded-panel bg-pink-100 px-6 py-10 md:px-12 md:py-12">
        <h2 id="after-heading" class="text-h2 text-olive-800">
          {kind === 'event' && post.upcoming ? 'Want to help at this event?' : 'Want to help at the next one?'}
        </h2>
        <p class="mt-3 max-w-xl text-lead text-ink-600">
          Send us a message and tell us how you would like to help. We will reply with the next step.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <Button href={contactHref('volunteer')} size="lg">Volunteer with us</Button>
          <Button href="/events/" variant="secondary" size="lg">See all events and news</Button>
        </div>
      </div>
    </section>
  </article>
</PageLayout>
