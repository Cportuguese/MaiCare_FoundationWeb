---
/**
 * Button
 * ------
 * variant="primary"   solid pink. ONE per section. For the main action.
 * variant="secondary" green outline. For the second action.
 * variant="on-dark"   cream. The button to use on green / plum backgrounds.
 *
 * Pass `href` and you get a link (<a>); leave it out and you get a <button>.
 * Always 48px tall or more, so it is easy to tap on a phone.
 * A button says exactly what happens: "Donate food", not "Click here".
 *
 * Remember (project rule): there are NO online payments. "Donate" buttons go
 * to the How to Donate section or open the contact form with an option
 * preselected.
 */
import Icon, { type IconName } from './Icon.astro';

interface Props {
  variant?: 'primary' | 'secondary' | 'on-dark';
  href?: string;
  size?: 'md' | 'lg';
  /** Optional Lucide icon after the label. Use sparingly. */
  icon?: IconName;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  [attr: string]: unknown;
}

const {
  variant = 'primary',
  href,
  size = 'md',
  icon,
  type = 'button',
  class: className,
  ...rest
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-full font-semibold leading-none ' +
  'no-underline cursor-pointer select-none whitespace-nowrap ' +
  'transition-[background-color,box-shadow,transform,color] duration-200 ease-[var(--ease-soft)] ' +
  'active:translate-y-px disabled:opacity-60 disabled:cursor-not-allowed';

const sizes = {
  md: 'min-h-12 px-6 text-[0.9375rem]',
  lg: 'min-h-14 px-8 text-base',
};

const variants = {
  primary:
    'bg-pink-600 text-white shadow-[var(--shadow-button)] hover:bg-pink-700 hover:-translate-y-0.5',
  secondary:
    'bg-transparent text-green-800 border-2 border-green-800 hover:bg-green-800 hover:text-pink-50',
  'on-dark':
    'bg-cream-200 text-green-900 hover:bg-cream-100 hover:-translate-y-0.5',
};

const classes = [base, sizes[size], variants[variant], className].filter(Boolean).join(' ');
const Tag = href ? 'a' : 'button';
const attrs = href ? { href, ...rest } : { type, ...rest };
---

<Tag class={classes} {...attrs}>
  <slot />
  {icon && <Icon name={icon} size={18} />}
</Tag>
