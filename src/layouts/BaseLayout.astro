---
// Bare-bones layout for Phase 1. The real shared layout (header, footer,
// emergency banner) is built in Phase 3.
import '../styles/global.css';
import { identity } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Keep this page out of search engines (used by the hidden style guide). */
  noindex?: boolean;
}

const { title = identity.name, description = identity.description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
